# Names only. Never commit real values. Settings are loaded by breakdown.bootstrap.
# Auth credentials for any future model backend follow that SDK's own environment
# convention and are never managed by Breakdown settings.
BREAKDOWN_WORKFLOW_PATH=breakdown.yaml
BREAKDOWN_TARGET_REPO=.
BREAKDOWN_STATE_ROOT=.breakdown
BREAKDOWN_BACKEND_BINDINGS_PATH=

# Live OpenAI-compatible API (Phase 3a). Names only — never commit real values.
# Databricks Model Serving recipe:
#   BREAKDOWN_API_BASE_URL=https://<workspace-url>/serving-endpoints/<endpoint-name>/v1
#   BREAKDOWN_API_KEY=<databricks-pat>
# Custom gateway (LiteLLM/vLLM/Ollama-style) or OpenAI:
#   BREAKDOWN_API_BASE_URL=https://<gateway>/v1
#   BREAKDOWN_API_KEY=<key>
BREAKDOWN_API_BASE_URL=
BREAKDOWN_API_KEY=
BREAKDOWN_MODEL=
# Optional two-tier economics: frontier models for judgment roles, cheaper
# models for token-heavy reading (falls back to BREAKDOWN_MODEL).
BREAKDOWN_MODEL_AUDITOR=
BREAKDOWN_MODEL_RESEARCHER=
BREAKDOWN_MODEL_CODER=
BREAKDOWN_MODEL_PLANNER=
# Separate model tiers for sandbox execution and independent verification.
BREAKDOWN_MODEL_BUILDER=
BREAKDOWN_MODEL_VERIFIER=
BREAKDOWN_API_MAX_TOOL_ROUNDS=8
